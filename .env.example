# Copia questo file in .env.local e inserisci le tue API key:
#   cp .env.example .env.local
#
# Ottieni la chiave su: https://resend.com/api-keys

RESEND_API_KEY=

# Opzionale — default già configurati per funzionare subito.
# Con il dominio di test Resend puoi inviare solo all'email del tuo account Resend.
# Per produzione: verifica un dominio su Resend e aggiorna EMAIL_FROM.
# EMAIL_FROM="Rete Italiana Disabili <onboarding@resend.dev>"
# EMAIL_TO=inforeteitalianadisabili@gmail.com

# Stripe — chiave segreta (Dashboard → Developers → API keys)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Opzionale — URL pubblico del sito (success/cancel Checkout).
# In locale viene dedotto da Origin/Host della richiesta.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opzionale — secret del webhook Stripe (per /api/stripe/webhook)
# STRIPE_WEBHOOK_SECRET=
